# HALO build of heesch-sat for Linux (tested: Ubuntu 24.04, g++ 13, CryptoMiniSat 5.11.15).
# Upstream's Makefile is out of date: the code needs C++20 and sat must link isohedral.o.
INCLUDES = -I/usr/include/cryptominisat5
CXX = g++
OPT = -O3 -DNDEBUG -march=native
CXXFLAGS = -std=c++20 -Wall -MMD $(INCLUDES) $(OPT)
LIBS = -lcryptominisat5 -lpthread

all: sat gen report surrounds

sat: sat.o isohedral.o
	$(CXX) -o sat sat.o isohedral.o $(LIBS)
gen: gen.o
	$(CXX) -o gen gen.o $(LIBS)
report: report.o
	$(CXX) -o report report.o $(LIBS)
surrounds: surrounds.o
	$(CXX) -o surrounds surrounds.o $(LIBS)
defect: defect.o isohedral.o
	$(CXX) -o defect defect.o isohedral.o $(LIBS)
viz: viz.o
	$(CXX) -o viz viz.o $(LIBS) $(shell pkg-config --libs cairo)
viz.o: CXXFLAGS += $(shell pkg-config --cflags cairo)

-include $(wildcard *.d)
